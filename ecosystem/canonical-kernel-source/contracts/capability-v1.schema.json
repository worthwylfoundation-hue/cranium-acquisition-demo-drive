{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://convertible-cranium.org/contracts/capability-v1.schema.json",
  "title": "Convertible Cranium Capability v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "capability_id",
    "subject_id",
    "action",
    "scope",
    "risk_ceiling",
    "grantor",
    "issued_at"
  ],
  "properties": {
    "version": {
      "const": "capability-v1"
    },
    "capability_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "grantor": {
      "type": "string",
      "minLength": 1
    },
    "delegation_chain": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revocation_ref": {
      "type": "string"
    },
    "policy_id": {
      "type": "string"
    },
    "policy_hash": {
      "type": "string"
    },
    "constitution_hash": {
      "type": "string"
    }
  }
}
